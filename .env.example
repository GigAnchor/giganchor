NEXT_PUBLIC_API_URL=http://localhost:4000

# Repository used for "Edit this page", source links, release feed and
# community metrics (owner/name). Defaults to the canonical repository.
NEXT_PUBLIC_GITHUB_REPO=GigAnchor/giganchor

# Giganchor SDK
GIGANCHOR_API_KEY=your_giganchor_api_key_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Database URLs (optional, for backend/migrations)
DATABASE_URL=your_database_url_here
DIRECT_URL=your_direct_database_url_here

# Production Domain
NEXT_PUBLIC_SITE_URL=https://giganchor.tech

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1